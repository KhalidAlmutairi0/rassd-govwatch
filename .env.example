# Database
DATABASE_URL="file:./dev.db"

# AI Provider (optional — system works without it)
# Vision (page understanding + element verdict) uses gpt-4o; text-only
# summaries route to gpt-4o-mini. Provider is auto-detected in this priority:
#   OPENAI_API_KEY → GROQ_API_KEY → template fallback
OPENAI_API_KEY="sk-..."               # OpenAI (preferred — supports vision)
GROQ_API_KEY="gsk_..."                # Groq fallback (text only, no vision)

# WebSocket (worker process serves the live browser stream)
NEXT_PUBLIC_WS_URL="ws://localhost:3003"
WORKER_PORT=3003

# Artifact retention (days). Daily cron prunes older runs' artifact dirs.
ARTIFACT_RETENTION_DAYS=7
