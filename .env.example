# Database
DATABASE_URL="file:./dev.db"

# AI Provider (optional — system works without these)
# Vision (page understanding + element verdict) uses Sonnet; text-only
# summaries route to Haiku. Provider is auto-detected in this priority:
#   ANTHROPIC_API_KEY → OPENAI_API_KEY → GROQ_API_KEY → template fallback
ANTHROPIC_API_KEY="sk-ant-..."        # Claude (preferred — supports vision)
OPENAI_API_KEY="sk-..."               # OpenAI fallback (supports vision)
GROQ_API_KEY="gsk_..."                # Groq fallback (text only, no vision)

# Execution mode
# "plan" (default) — single AI call, fast, deterministic
# "mcp"  — iterative tool-use agent, slower, exploratory
AI_EXECUTION_MODE="plan"

# WebSocket (worker process serves the live browser stream)
NEXT_PUBLIC_WS_URL="ws://localhost:3003"
WORKER_PORT=3003

# Artifact retention (days). Daily cron prunes older runs' artifact dirs.
ARTIFACT_RETENTION_DAYS=7
