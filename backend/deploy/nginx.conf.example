map $http_upgrade $rasd_connection {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl;
    server_name api.rasd.example.com;
    ssl_certificate /etc/letsencrypt/live/api.rasd.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.rasd.example.com/privkey.pem;
    client_max_body_size 64k;

    location /live/ {
        proxy_pass http://127.0.0.1:4001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $rasd_connection;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }

    location ~ ^/api/health/?$ {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:4000;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 45s;
    }
}
