API_HOST=127.0.0.1
API_PORT=4000
WORKER_HOST=127.0.0.1
WORKER_PORT=4001
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Paths are relative to this backend package unless absolute.
DATA_DIR=./data
# DATABASE_URL=file:../data/rasd.db
# ARTIFACTS_DIR=/var/lib/rasd/artifacts

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Azure OpenAI uses the v1 Responses API; no dated API version is required.
# Azure takes precedence when its API key is set.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Endpoint example: https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
# Deployment example: gpt-5.6-sol (must match your Azure deployment name)
AI_PRIORITIZATION=false
SCHEDULER_ENABLED=true
RUN_TIMEOUT_MS=120000
MIN_FREE_DISK_MB=512
ARTIFACT_RETENTION_DAYS=7
RECORD_TRACE=false
LOG_DATABASE_QUERIES=false
