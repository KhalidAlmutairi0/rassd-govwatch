{
  "name": "rasd",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev:frontend": "npm run dev --workspace @rasd/frontend",
    "dev:backend": "npm run dev --workspace @rasd/backend",
    "build": "npm run build --workspace @rasd/backend && npm run build --workspace @rasd/frontend",
    "build:frontend": "npm run build --workspace @rasd/frontend",
    "build:backend": "npm run build --workspace @rasd/backend",
    "start:frontend": "npm run start --workspace @rasd/frontend",
    "start:backend": "npm run start --workspace @rasd/backend",
    "db:migrate": "npm run db:migrate --workspace @rasd/backend",
    "setup:backend": "npm run setup --workspace @rasd/backend",
    "seed": "npm run seed --workspace @rasd/backend",
    "lint": "npm run lint --workspace @rasd/frontend",
    "typecheck": "npm run db:generate --workspace @rasd/backend && npm run typecheck --workspaces"
  },
  "overrides": { "postcss": "^8.5.23" },
  "engines": { "node": ">=22.16.0" }
}
