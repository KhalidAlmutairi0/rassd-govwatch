# Leave the API URL empty to run the screens in standalone preview mode.
# Set both public URLs when connecting to a separately deployed backend.
# These public values are embedded during next build.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_WS_URL=ws://localhost:4001
# For a single domain with /api/* and WebSocket proxying:
# NEXT_PUBLIC_API_URL=same-origin
# NEXT_PUBLIC_WS_URL=same-origin
