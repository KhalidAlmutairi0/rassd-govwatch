[Unit]
Description=Rasd frontend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=rasd
Group=rasd
WorkingDirectory=/opt/rasd/frontend
EnvironmentFile=/etc/rasd/frontend.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
MemoryMax=1G
TasksMax=128
LimitNOFILE=4096
UMask=0077
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/opt/rasd/frontend/.next/cache

[Install]
WantedBy=multi-user.target
